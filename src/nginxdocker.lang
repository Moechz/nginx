[th-th]
name         = "Nginx Web Server"
auth         = "Nginx, Inc."
version      = "@@VERSION@@"
descript     = "Nginx เป็นเว็บเซิร์ฟเวอร์และรีเวิร์สพร็อกซีโอเพนซอร์สที่ใช้กันแพร่หลายที่สุดในโลก แอปนี้รันอิมเมจ Nginx อย่างเป็นทางการจาก Docker Hub เป็นคอนเทนเนอร์แบบไม่ใช้ root บน NAS ของคุณ และเปิดให้ใช้ที่พอร์ต 8081 วางเว็บไซต์ของคุณในโฟลเดอร์ www ของแอป หรือเพิ่มรีเวิร์สพร็อกซีและเว็บไซต์เพิ่มเติมเป็นไฟล์กำหนดค่าเล็ก ๆ ในโฟลเดอร์ config"
release_note = "1. เวอร์ชันแรก: อิมเมจ Nginx 1.29.8 อย่างเป็นทางการจาก Docker Hub ทำงานด้วยผู้ใช้ที่ไม่ใช่ root ที่พอร์ต 8081 ในการเริ่มครั้งแรกจะสร้างเว็บไซต์เริ่มต้น หน้าต้อนรับ และตัวอย่างการกำหนดค่าที่มีคำอธิบาย"
important    = "ต้องมี DockerEngine (App Center จะติดตั้งให้อัตโนมัติหากไม่มี) เปิดแอปที่ http://<NAS-IP>:8081/ ไฟล์ทั้งหมดเก็บไว้ในโฟลเดอร์ข้อมูลของแอป (<volume>/DockerAppData/nginxdocker) เนื้อหาเว็บอยู่ใน 'www' ส่วนเว็บไซต์และรีเวิร์สพร็อกซีอยู่ใน 'config' เปิดพอร์ตเฉพาะ 8080 ของคอนเทนเนอร์ ตรวจสอบการแก้ไขด้วย 'docker exec nginxdocker nginx -t' แล้วรีสตาร์ตแอป ดูบันทึกด้วย 'docker logs nginxdocker' สำรองข้อมูลก่อนถอนการติดตั้งแบบลบข้อมูล"

[vi-vn]
name         = "Nginx Web Server"
auth         = "Nginx, Inc."
version      = "@@VERSION@@"
descript     = "Nginx là máy chủ web và proxy ngược mã nguồn mở được dùng rộng rãi nhất thế giới. Ứng dụng này chạy image Nginx chính thức từ Docker Hub dưới dạng container không đặc quyền trên NAS của bạn và công bố ở cổng 8081. Hãy đặt website của bạn vào thư mục www của ứng dụng, hoặc thêm proxy ngược và các site khác dưới dạng tệp cấu hình nhỏ trong thư mục config."
release_note = "1. Bản phát hành đầu tiên: image Nginx 1.29.8 chính thức từ Docker Hub, chạy bằng người dùng không phải root ở cổng 8081. Lần khởi động đầu tiên sẽ tạo site mặc định, trang chào mừng và các ví dụ cấu hình có chú thích."
important    = "Cần DockerEngine (App Center sẽ tự cài nếu thiếu). Mở ứng dụng tại http://<NAS-IP>:8081/. Mọi tệp được lưu trong thư mục dữ liệu ứng dụng (<volume>/DockerAppData/nginxdocker): nội dung web trong 'www', site và proxy ngược trong 'config'. Chỉ cổng 8080 của container được công bố. Kiểm tra thay đổi bằng 'docker exec nginxdocker nginx -t' rồi khởi động lại ứng dụng. Nhật ký: 'docker logs nginxdocker'. Sao lưu thư mục dữ liệu trước khi gỡ cài đặt kèm xóa dữ liệu."

